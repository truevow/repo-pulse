# Postgres connection string (required)
DATABASE_URL=postgresql://repo_pulse:repo_pulse@localhost:5432/repo_pulse
# GitHub personal access token used for syncing (optional, raises rate limits)
GITHUB_TOKEN=ghp_your_token_here
# Anthropic API key for narrative generation (optional)
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Anthropic model id used for narratives
ANTHROPIC_MODEL=claude-opus-5-5
# Anthropic effort level: low | medium | high
ANTHROPIC_EFFORT=medium
# HTTP port to listen on
PORT=3000
# Maximum number of weeks of history to sync
SYNC_MAX_WEEKS=26
# Narrative endpoint rate limit (requests per minute)
NARRATIVE_RATE_LIMIT_PER_MIN=10
# Allowed CORS origin(s), comma-separated; leave empty to disable CORS
CORS_ORIGIN=
# Log level: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
# Runtime mode: development | test | production
NODE_ENV=development
