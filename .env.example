# Postgres connection string (required). Matches the compose `db` service.
DATABASE_URL=postgresql://repo_pulse:repo_pulse@localhost:5432/repo_pulse
# GitHub personal access token (required only for live sync: GitHub GraphQL needs auth).
# A fine-grained token with public-repository read access and no other permissions is enough.
GITHUB_TOKEN=
# Anthropic API key (required for the narrative endpoint on a cache miss; without it
# /narrative answers 503 llm-not-configured and everything else still works).
ANTHROPIC_API_KEY=
# Anthropic model id used for narratives (part of the narrative cache key)
ANTHROPIC_MODEL=claude-opus-5-5
# Anthropic effort level: low | medium | high (part of the narrative cache key)
ANTHROPIC_EFFORT=medium
# HTTP port to listen on
PORT=3000
# Maximum window length in weeks, for sync, insights and narrative
SYNC_MAX_WEEKS=26
# Narrative endpoint rate limit per client IP (requests per minute)
NARRATIVE_RATE_LIMIT_PER_MIN=10
# Allowed CORS origin(s), comma-separated; leave empty for same-origin only
CORS_ORIGIN=
# Log level: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
# Runtime mode: development (pretty logs) | test | production (JSON logs)
NODE_ENV=development
